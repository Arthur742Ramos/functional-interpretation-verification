import TypedWordBridge

/-!
The least compatible equivalence generated by the selected structural roots.
All relations are indexed by fixed endpoints. Equality of normalised expansions
is a theorem about this inductive relation, not its definition.
-/
namespace StructuralReasons
universe u v
variable {V : Type u} {E : V → V → Type v}
open Words

/-- Closure of the root equations under equivalence and typed constructors. -/
inductive ReasonCongruence (complete : Bool) :
    {a b : V} → Reason E a b → Reason E a b → Prop where
  | root {a b : V} {p q : Reason E a b} :
      Root complete p q → ReasonCongruence complete p q
  | refl {a b : V} (p : Reason E a b) : ReasonCongruence complete p p
  | symm {a b : V} {p q : Reason E a b} :
      ReasonCongruence complete p q → ReasonCongruence complete q p
  | trans {a b : V} {p q r : Reason E a b} :
      ReasonCongruence complete p q → ReasonCongruence complete q r →
      ReasonCongruence complete p r
  | sigma {a b : V} {p q : Reason E a b} :
      ReasonCongruence complete p q → ReasonCongruence complete (.sigma p) (.sigma q)
  | left {a b c : V} {p q : Reason E a b} (r : Reason E b c) :
      ReasonCongruence complete p q → ReasonCongruence complete (.tau p r) (.tau q r)
  | right {a b c : V} (p : Reason E a b) {q r : Reason E b c} :
      ReasonCongruence complete q r → ReasonCongruence complete (.tau p q) (.tau p r)

/-- A competing equivalence on each hom-set, compatible with both operations. -/
structure CompatibleEquivalence
    (C : {a b : V} → Reason E a b → Reason E a b → Prop) : Prop where
  refl : ∀ {a b} (p : Reason E a b), C p p
  symm : ∀ {a b} {p q : Reason E a b}, C p q → C q p
  trans : ∀ {a b} {p q r : Reason E a b}, C p q → C q r → C p r
  sigma : ∀ {a b} {p q : Reason E a b}, C p q → C (.sigma p) (.sigma q)
  tau : ∀ {a b c} {p p' : Reason E a b} {q q' : Reason E b c},
    C p p' → C q q' → C (.tau p q) (.tau p' q')

namespace ReasonCongruence
variable {complete : Bool}

theorem tau {a b c : V} {p p' : Reason E a b} {q q' : Reason E b c}
    (h : ReasonCongruence complete p p') (k : ReasonCongruence complete q q') :
    ReasonCongruence complete (.tau p q) (.tau p' q') :=
  .trans (.left q h) (.right p' k)

theorem compatible (complete : Bool) :
    CompatibleEquivalence (E := E) (ReasonCongruence complete) :=
  ⟨refl, symm, trans, sigma, tau⟩

/-- The closure is contained in every compatible equivalence containing the roots. -/
theorem least {C : {a b : V} → Reason E a b → Reason E a b → Prop}
    (hc : CompatibleEquivalence C)
    (hr : ∀ {a b} {p q : Reason E a b}, Root complete p q → C p q)
    {a b : V} {p q : Reason E a b} (h : ReasonCongruence complete p q) : C p q := by
  induction h with
  | root h => exact hr h
  | refl p => exact hc.refl p
  | symm h ih => exact hc.symm ih
  | trans h k ih ik => exact hc.trans ih ik
  | sigma h ih => exact hc.sigma ih
  | left r h ih => exact hc.tau ih (hc.refl r)
  | right p h ih => exact hc.tau (hc.refl p) ih

theorem of_step {a b : V} {p q : Reason E a b} (h : Step complete p q) :
    ReasonCongruence complete p q := by
  induction h with
  | root h => exact .root h
  | sigma h ih => exact .sigma ih
  | left r h ih => exact .left r ih
  | right p h ih => exact .right p ih

theorem of_steps {a b : V} {p q : Reason E a b} (h : Steps complete p q) :
    ReasonCongruence complete p q := by
  induction h with
  | refl p => exact .refl p
  | cons h k ih => exact .trans (of_step h) ih

/-- Equivalently, least among compatible equivalences containing contextual steps. -/
theorem least_steps {C : {a b : V} → Reason E a b → Reason E a b → Prop}
    (hc : CompatibleEquivalence C)
    (hs : ∀ {a b} {p q : Reason E a b}, Step complete p q → C p q)
    {a b : V} {p q : Reason E a b} (h : ReasonCongruence complete p q) : C p q :=
  least hc (fun h => hs (.root h)) h

/-- Rule 36's equation follows by reverse associativity, cancellation, and a unit. -/
theorem eight_cancelSuffix {a b c : V} (p : Reason E a b) (q : Reason E a c) :
    ReasonCongruence false (.tau p (.tau (.sigma p) q)) q :=
  .trans (.symm (.root (.tt p (.sigma p) q)))
    (.trans (.left q (.root (.tr p))) (.root (.tlr q)))

/-- The corrected rule 37 returns q, with endpoints b and c unchanged. -/
theorem eight_cancelInvSuffix {a b c : V} (p : Reason E a b) (q : Reason E b c) :
    ReasonCongruence false (.tau (.sigma p) (.tau p q)) q :=
  .trans (.symm (.root (.tt (.sigma p) p q)))
    (.trans (.left q (.root (.tsr p))) (.root (.tlr q)))

/-- Each root of either presentation is an equation of the eight-rule closure. -/
theorem root_to_eight {a b : V} {p q : Reason E a b} (h : Root complete p q) :
    ReasonCongruence false p q := by
  cases h with
  | sr a => exact .root (.sr a)
  | ss => exact .root (.ss _)
  | tr p => exact .root (.tr p)
  | tsr p => exact .root (.tsr p)
  | trr => exact .root (.trr _)
  | tlr => exact .root (.tlr _)
  | st p q => exact .root (.st p q)
  | tt p q r => exact .root (.tt p q r)
  | cancelSuffix enabled p q => exact eight_cancelSuffix p q
  | cancelInvSuffix enabled p q => exact eight_cancelInvSuffix p q

theorem to_eight {a b : V} {p q : Reason E a b} (h : ReasonCongruence complete p q) :
    ReasonCongruence false p q := least (compatible false) root_to_eight h

theorem root_to_ten {a b : V} {p q : Reason E a b} (h : Root complete p q) :
    ReasonCongruence true p q := by
  cases h with
  | sr a => exact .root (.sr a)
  | ss => exact .root (.ss _)
  | tr p => exact .root (.tr p)
  | tsr p => exact .root (.tsr p)
  | trr => exact .root (.trr _)
  | tlr => exact .root (.tlr _)
  | st p q => exact .root (.st p q)
  | tt p q r => exact .root (.tt p q r)
  | cancelSuffix enabled p q => exact .root (.cancelSuffix rfl p q)
  | cancelInvSuffix enabled p q => exact .root (.cancelInvSuffix rfl p q)

theorem to_ten {a b : V} {p q : Reason E a b} (h : ReasonCongruence complete p q) :
    ReasonCongruence true p q := least (compatible true) root_to_ten h

theorem eight_iff_ten {a b : V} (p q : Reason E a b) :
    ReasonCongruence false p q ↔ ReasonCongruence true p q := ⟨to_ten, to_eight⟩

/-- Equality of the two relations on each fixed hom-set. -/
theorem eight_eq_ten (a b : V) :
    (@ReasonCongruence V E false a b) = (@ReasonCongruence V E true a b) := by
  funext p q
  exact propext (eight_iff_ten p q)

theorem action_eq {a b : V} {p q : Reason E a b}
    (h : ReasonCongruence complete p q) : action p = action q := by
  induction h with
  | root h => exact root_action h
  | refl p => rfl
  | symm h ih => exact ih.symm
  | trans h k ih ik => exact ih.trans ik
  | sigma h ih => exact congrArg Action.reverse ih
  | left r h ih => exact congrArg (fun f => Action.mul f (action r)) ih
  | right p h ih => exact congrArg (Action.mul (action p)) ih

theorem reducedExpansion_eq {a b : V} {p q : Reason E a b}
    (h : ReasonCongruence complete p q) : reducedExpansion p = reducedExpansion q :=
  congrArg (fun f : Action (RWord (EdgeId E)) => (f.forward empty).val) (action_eq h)

/-- Equal invariants give a common ten-rule normal descendant. -/
theorem common_normal_of_reducedExpansion_eq {a b : V} {p q : Reason E a b}
    (h : reducedExpansion p = reducedExpansion q) :
    ∃ n, Steps true p n ∧ Steps true q n ∧ Normal true n := by
  obtain ⟨np, hp, hnp⟩ := exists_normal true p
  obtain ⟨nq, hq, hnq⟩ := exists_normal true q
  have he := (steps_reducedExpansion hp).symm.trans (h.trans (steps_reducedExpansion hq))
  have hn := normal_expansion_injective hnp hnq he
  subst nq
  exact ⟨np, hp, hq, hnp⟩

theorem eight_of_reducedExpansion_eq {a b : V} {p q : Reason E a b}
    (h : reducedExpansion p = reducedExpansion q) : ReasonCongruence false p q := by
  obtain ⟨n, hp, hq, _⟩ := common_normal_of_reducedExpansion_eq h
  exact to_eight (.trans (of_steps hp) (.symm (of_steps hq)))

theorem iff_reducedExpansion_eq {a b : V} (p q : Reason E a b) :
    ReasonCongruence complete p q ↔ reducedExpansion p = reducedExpansion q := by
  constructor
  · exact reducedExpansion_eq
  · intro h
    cases complete with
    | false => exact eight_of_reducedExpansion_eq h
    | true => exact to_ten (eight_of_reducedExpansion_eq h)

/-- The invariant is the ordinary deletion normal form of literal expansion. -/
theorem iff_stack_expansion_eq {a b : V} (p q : Reason E a b) :
    ReasonCongruence complete p q ↔
      (stack (expansion p)).val = (stack (expansion q)).val := by
  rw [iff_reducedExpansion_eq, reducedExpansion_eq_stack_expansion,
    reducedExpansion_eq_stack_expansion]

/-- A reason's literal expansion, carrying its fixed endpoints. -/
def typedExpansion {a b : V} (p : Reason E a b) : TypedWord E a b :=
  ⟨expansion p, expansion_walk p⟩

theorem iff_typed_word_equiv {a b : V} (p q : Reason E a b) :
    ReasonCongruence complete p q ↔ TypedWord.Equiv (typedExpansion p) (typedExpansion q) := by
  rw [TypedWord.equiv_iff_normalise_eq, iff_stack_expansion_eq]
  exact ⟨fun h => Subtype.ext h, fun h => congrArg (fun w : TypedWord E a b => w.val) h⟩

/-- Both comparisons, with no change of hom-set, in one statement. -/
theorem comparison {a b : V} (p q : Reason E a b) :
    (ReasonCongruence false p q ↔ ReasonCongruence true p q) ∧
    (ReasonCongruence false p q ↔ TypedWord.Equiv (typedExpansion p) (typedExpansion q)) ∧
    (ReasonCongruence false p q ↔ (stack (expansion p)).val = (stack (expansion q)).val) :=
  ⟨eight_iff_ten p q, iff_typed_word_equiv p q, iff_stack_expansion_eq p q⟩

end ReasonCongruence
end StructuralReasons
